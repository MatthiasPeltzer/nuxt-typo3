{
  "name": "@libs/nuxt-typo3",
  "version": "2.3.1",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.mjs"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "types": "./dist/types.d.mts",
  "main": "./dist/module.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "test": "vitest run",
    "lint": "eslint .",
    "prerelease": "pnpm test && npx standard-version --prerelease alpha && git push --follow-tags && npm publish --tag alpha",
    "release": "pnpm test && npx standard-version && git push --follow-tags && npm publish",
    "commitlint": "commitlint --verbose",
    "husky:install": "husky"
  },
  "dependencies": {
    "defu": "6.1.7",
    "sanitize-html": "^2.17.0",
    "ofetch": "1.5.1",
    "ohash": "^2.0.12",
    "scule": "1.3.0",
    "ufo": "1.6.4"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@nuxt/eslint-config": "1.17.0",
    "@nuxt/kit": "4.5.2",
    "@nuxt/module-builder": "1.0.3",
    "@nuxt/schema": "4.5.2",
    "@nuxt/test-utils": "^4.2.0",
    "@types/semver": "^7.8.0",
    "eslint": "^10.10.0",
    "h3": "^1.15.11",
    "husky": "9.1.7",
    "listhen": "^1.10.1",
    "nuxt": "4.5.2",
    "playwright": "^1.63.0",
    "standard-version": "9.5.0",
    "typescript": "^6.0.3",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.11",
    "vue-tsc": "3.3.11"
  },
  "packageManager": "pnpm@9.14.4",
  "engines": {
    "node": ">=18.20.5",
    "pnpm": ">=9.14.4"
  },
  "volta": {
    "node": "22.12.0",
    "pnpm": "9.14.4"
  }
}
